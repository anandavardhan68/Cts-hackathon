# Server Configuration
PORT=4000

# PostgreSQL Configuration
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/fdaas

# Neo4j Graph Database Configuration (AuraDB)
NEO4J_URI=neo4j+s://<YOUR_DB_ID>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_aura_db_password

# ML Service Connection
FLASK_URL=http://127.0.0.1:5001

# Security Secrets
# MUST EXACTLY MATCH THE SECRET IN graph/.env OR QUERIES WILL FAIL
DEVICE_HASH_SECRET=super_secret_string_for_demo